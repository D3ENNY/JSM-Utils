{
  "manifest_version": 3,
  "name": "JSM-utils",
  "version": "1.0.0",
  "description": "Implementa nuove funzioni in JSM",
  "host_permissions": ["https://*.atlassian.net/*"],
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/shared/*.js"],
      "matches": ["https://*.atlassian.net/*"]
    }
  ],
  "icons": {
    "16": "assets/icons/favicon.png",
    "48": "assets/icons/favicon.png",
    "128": "assets/icons/favicon.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/favicon.png",
      "48": "assets/icons/favicon.png",
      "128": "assets/icons/favicon.png"
    }
  }
}
